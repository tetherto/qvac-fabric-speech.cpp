  "workloads": {
    "benchmark-prompt": {
      "description": "The Chatterbox Core ML benchmark prompt: three sentences, two segments at max_sentence_chars 180 (engines/tts/docs/chatterbox.md:134-137).",
      "text": {
        "root": "repo",
        "path": "scripts/benchmarks/fixtures/tts-intelligibility.txt",
        "sha256": "fc1943705a10ee241c67af032220e7c151519f34b9449b3892ccf4cf4ae5e294",
        "bytes": 197
      },
      "max_sentence_chars": 180,
      "voice": "built-in",
      "seed": 42
    },
    "length-sweep": {
      "description": "One S3Gen call per sentence for the Metal cost fit: each process synthesizes the warmup sentence, then one sweep sentence as its own segment (max_sentence_chars = its length); the warmup call is discarded.",
      "warmup": "Hello there.",
      "sentences": [
        "The cat sat down.",
        "Please bring the blue notebook before we leave.",
        "The morning train arrived beside the quiet river while the station clock struck seven.",
        "A young traveler opened the window and watched the sunlight move slowly across the green hills, the farms, and the small white houses.",
        "When the storm finally passed over the valley, the villagers walked down to the harbor to count the boats, mend the torn nets, and thank the sailors who had stayed out all night.",
        "Long after the last guests had left the old house on the hill, the musicians kept playing in the empty hall, slowly and softly, as if the candles, the portraits, and the tall dark windows were still listening to every single note they played."
      ],
      "voice": "built-in",
      "seed": 42
    }
  },

  },
  "measurements": {
    "sizes": {
      "what": "Multifunction spec sizes: model.mil, model.mlmodel, weight.bin, zlib and LZFSE sizes, per stage and width set.",
      "variants": ["turbo", "mtl"],
      "sets": ["w7", "w3"]
    },
    "memory": {
      "what": "The runtime's available-memory reading under the normal desktop load (the input to memory admission), against each artifact's ane_compile_reserve_bytes.",
      "samples": 120,
      "interval_ms": 1000
    },
    "load": {
      "what": "Per function: cold load (fresh identity, fresh path), warm load + first prediction (expected_warm_load_ms), prediction time, and whether loaded functions share weight memory.",
      "variants": ["turbo", "mtl"],
      "sets": ["w7", "w3"],
      "warm_runs": 5,
      "predictions": 5,
      "sharing_runs": 3,
      "sharing_units": ["cpu_and_ane", "cpu_only"]
    },
    "ttr": {
      "what": "Time until every function is ready, with and without the admission gate, the worst-case prepare-queue wait, and cached startup with the same identity.",
      "variants": ["turbo", "mtl"],
      "configs": [
        {"name": "prebuilt-gated", "route": "prebuilt", "mode": "manager", "set": "w7", "runs": 5, "cached_startup_runs": 1},
        {"name": "prebuilt-gated-w3", "route": "prebuilt", "mode": "manager", "set": "w3", "runs": 3, "cached_startup_runs": 1},
        {"name": "generate-gated", "route": "generate", "mode": "manager", "set": "w7", "runs": 5},
        {"name": "generate-ungated", "route": "generate", "mode": "ungated", "set": "w7", "runs": 5}
      ],
      "memory_admission": true,
      "timeout_s": 1800
    },
    "metal_cost": {
      "what": "Per-variant linear Metal cost constants for s3gen_estimate_metal_ms: stage ms = a + b x frames, from CHATTERBOX_CHUNK_PROFILE.",
      "variants": ["turbo", "mtl"],
      "workload": "length-sweep",
      "runs": 3
    },
    "synthesis": {
      "what": "Warm tts-cli synthesis on the benchmark prompt: Metal, Core ML with 7 and 3 widths (padding cost), and Core ML without the encoder sidecar (encoder-fallback contention during overlap).",
      "variants": ["turbo", "mtl"],
      "workload": "benchmark-prompt",
      "configs": [
        {"name": "metal", "coreml": false},
        {"name": "coreml-w7", "coreml": true, "set": "w7", "stages": ["encoder", "cfm", "hift"]},
        {"name": "coreml-w3", "coreml": true, "set": "w3", "stages": ["encoder", "cfm", "hift"]},
        {"name": "coreml-no-encoder", "coreml": true, "set": "w7", "stages": ["cfm", "hift"]}
      ],
      "runs": 3
    }
  }

{
  "schema": 1,
  "description": "Pinned workloads for scripts/coreml/bench-load-time.py. Files under root 'repo' are checked by --dry-run; files under root 'models' are checked with --check-models (QVAC_BENCH_MODELS, default ~/tether/models). Sidecars are exported locally from the pinned export_source GGUF with the pinned exporter options, so their digests are recorded per run in the results, not pinned here.",
  "host": {
    "chip": "Apple M2",
    "memsize_gb": 24,
    "os": "15.7.3",
    "power": "AC"
  },
  "protocol": {
    "ane_compiler_max_cpu_pct": 5,
    "quiet_calm_samples": 3,
    "quiet_timeout_s": 1800,
    "cache_glob": "~/Library/Caches/qvac-bench-*",
    "runs": {
      "metal": 10,
      "cold_prebuilt": 10,
      "cold_generate": 10,
      "time_to_ready": 5,
      "cached_startup": 5,
      "in_memory_ready": 5
    },
    "seed": 42,
    "units": "cpu_and_ane",
    "ane_compile_reserve_factor": 1.6
  },
  "exporter": {
    "script": "engines/tts/scripts/export-chatterbox-coreml.py",
    "python": "~/tether/models/.venv-coreml-py312 (coremltools 9.0, torch 2.7.0, gguf 0.19; engines/parakeet/scripts/requirements-coreml.txt)",
    "command": "export-chatterbox-coreml.py --gguf <export_source> --frames <frames> --output <dir> --compile"
  },
  "sidecar_sets": {
    "w7": {
      "dir": "chatterbox",
      "frames": [512, 640, 768, 896, 1024, 1280, 1536],
      "hift_window": 128,
      "stages": ["encoder", "cfm", "hift"]
    },
    "w3": {
      "dir": "chatterbox/w3",
      "frames": [512, 1024, 1536],
      "hift_window": 128,
      "stages": ["encoder", "cfm"],
      "hift_from": "w7"
    }
  },
